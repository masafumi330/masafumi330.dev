---
import { getPublishedArticles, getArticleBySlug, getArticleBlocks, blocksToHtml } from '../../lib/notion';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.slug } }));
}

const categoryLabels: Record<string, string> = {
  daily: '日記',
  tech: '技術',
};

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/articles');
}

const blocks = await getArticleBlocks(article.id);
const contentHtml = blocksToHtml(blocks);
---

<BaseLayout title={`${article.title} — Masafumi Misawa`}>
  <main>
    <article>
      <div class="prose">
        <header class="post-header">
          {article.date && (
            <p class="post-date">{article.date}</p>
          )}
          <h1>{article.title}</h1>
          {article.categories.length > 0 && (
            <p class="post-categories">{article.categories.map((c) => categoryLabels[c] ?? c).join(' · ')}</p>
          )}
        </header>
        <div set:html={contentHtml} />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: var(--max-w);
    flex: 1;
    padding: 3rem 0;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }

  .post-categories {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    margin-top: 0.5rem;
    opacity: 0.7;
  }

  h1 {
    font-size: 1.6rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    color: #fff;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .prose :global(h1) { font-size: 1.4rem; }
  .prose :global(h2) { font-size: 1.2rem; }
  .prose :global(h3) { font-size: 1rem; }

  .prose :global(p) {
    color: var(--fg);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: break-word;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .prose :global(pre) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--fg);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .prose :global(li) {
    margin-bottom: 0.25rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--fg-muted);
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose :global(img) {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1.25rem;
  }

  .prose :global(figure) {
    margin-bottom: 1.25rem;
  }

  .prose :global(figcaption) {
    text-align: center;
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 480px) {
    main { padding: 3rem 1rem; }
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    color: var(--fg);
  }

  .prose :global(th) {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-weight: 500;
  }

  .prose :global(.mermaid) {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1.5rem;
    text-align: center;
  }
</style>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({ startOnLoad: false, theme: 'dark' });

  document.querySelectorAll('pre > code.language-mermaid').forEach((code) => {
    const text = code.textContent ?? '';
    const div = document.createElement('div');
    div.className = 'mermaid';
    div.textContent = text;
    code.parentElement!.replaceWith(div);
  });

  mermaid.run();
</script>
