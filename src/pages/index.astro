---
const GITHUB_URL = 'https://github.com/masafumi330';
const X_URL = 'https://x.com/masafumi330';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Masafumi Misawa — Software Engineer</title>
    <meta name="description" content="Software Engineer based in Japan. Building web apps with Go and MySQL." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="avatar-wrap fade-up">
          <img src="/avatar.png" alt="Masafumi Misawa" class="avatar" width="160" height="160" />
        </div>

        <div class="hero-text fade-up delay-1">
          <p class="eyebrow">Software Engineer</p>
          <h1 class="name">Masafumi Misawa</h1>
          <p class="bio">
            妻と娘と日本で暮らしています。<br />
            Tunecire Japan で Go と MySQL を使ったWebアプリを開発しています。<br />
            音楽が大好きです。
          </p>
        </div>
      </section>

      <!-- Links -->
      <section class="links fade-up delay-2">
        <a
          href={GITHUB_URL}
          class="link-card"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
        >
          <span class="link-inner">
            <span class="link-label">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              GitHub
            </span>
            <span class="link-handle">@masafumi330</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <a
          href={X_URL}
          class="link-card"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter) profile"
        >
          <span class="link-inner">
            <span class="link-label">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.256 5.626L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
                ></path>
              </svg>
              X
            </span>
            <span class="link-handle">@masafumi330</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </section>
    </main>

    <footer class="fade-up delay-3">
      <p>© {new Date().getFullYear()} Masafumi Misawa</p>
    </footer>
  </body>
</html>

<style>
  /* ── Reset & base ── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #0f0f0f;
    --fg: #e8e8e8;
    --fg-muted: #888;
    --accent: #c8f5a0;
    --border: rgba(255, 255, 255, 0.08);
    --card-bg: rgba(255, 255, 255, 0.04);
    --font-mono: 'DM Mono', 'Fira Mono', monospace;
    --font-sans: 'DM Sans', system-ui, sans-serif;
    --max-w: 640px;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem;
  }

  /* ── Layout ── */
  main {
    width: 100%;
    max-width: var(--max-w);
    flex: 1;
    padding: 5rem 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  footer {
    width: 100%;
    max-width: var(--max-w);
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  /* ── Hero ── */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .avatar-wrap {
    width: fit-content;
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: var(--card-bg);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff;
    margin-bottom: 1.25rem;
  }

  .bio {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.9;
    max-width: 480px;
  }

  /* ── Links ── */
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--fg);
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .link-card:hover {
    border-color: var(--accent);
    background: rgba(200, 245, 160, 0.06);
    color: var(--accent);
  }

  .link-card:hover .link-handle {
    color: rgba(200, 245, 160, 0.6);
  }

  .link-card:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .link-inner {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .link-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .link-label svg {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .link-handle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
    padding-left: 1.65rem;
    transition: color 0.2s ease;
  }

  .arrow {
    font-size: 1.1rem;
    color: var(--fg-muted);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  /* ── Animations ── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-up {
    animation: fadeUp 0.6s ease both;
  }

  .delay-1 {
    animation-delay: 0.1s;
  }
  .delay-2 {
    animation-delay: 0.2s;
  }
  .delay-3 {
    animation-delay: 0.3s;
  }

  /* ── Responsive ── */
  @media (max-width: 480px) {
    main {
      padding: 3.5rem 1rem 2rem;
      gap: 3rem;
    }

    footer {
      padding: 1rem 1rem;
      gap: 3rem;
    }

    .name {
      font-size: 2rem;
    }
  }
</style>
