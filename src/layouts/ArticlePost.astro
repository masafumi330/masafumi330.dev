---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'articles'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={`${title} — Masafumi Misawa`} description={description}>
	<main>
		<article>
			{heroImage && (
				<div class="hero-image">
					<Image width={960} height={480} src={heroImage} alt="" class="hero-img" />
				</div>
			)}
			<div class="prose">
				<header class="post-header">
					<p class="post-date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated"> · Updated <FormattedDate date={updatedDate} /></span>
						)}
					</p>
					<h1>{title}</h1>
				</header>
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	main {
		width: 100%;
		max-width: var(--max-w);
		flex: 1;
		padding: 3rem 0;
	}

	.hero-image {
		margin-bottom: 2rem;
	}

	.hero-img {
		width: 100%;
		border-radius: 10px;
		object-fit: cover;
	}

	.post-header {
		margin-bottom: 2rem;
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-muted);
		margin-bottom: 0.5rem;
	}

	.updated {
		color: var(--fg-muted);
	}

	h1 {
		font-size: 1.6rem;
		font-weight: 500;
		color: #fff;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		color: #fff;
		font-weight: 500;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.prose :global(p) {
		color: var(--fg-muted);
		margin-bottom: 1.25rem;
	}

	.prose :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: rgba(255, 255, 255, 0.06);
		padding: 0.15em 0.4em;
		border-radius: 4px;
	}

	.prose :global(pre) {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.25rem;
		overflow-x: auto;
		margin-bottom: 1.5rem;
	}

	.prose :global(pre code) {
		background: none;
		padding: 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		color: var(--fg-muted);
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.prose :global(blockquote) {
		border-left: 2px solid var(--accent);
		padding-left: 1rem;
		color: var(--fg-muted);
		font-style: italic;
		margin-bottom: 1.25rem;
	}

	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2rem 0;
	}

	.prose :global(img) {
		width: 100%;
		border-radius: 8px;
		margin-bottom: 1.25rem;
	}

	@media (max-width: 480px) {
		main {
			padding: 3rem 1rem;
		}
	}
</style>
