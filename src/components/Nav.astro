---
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname.startsWith(href);
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">MM</a>
    <div class="nav-links">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]}>Home</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Blog</a>
      <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    width: 100%;
    padding: 1.5rem 0 0;
  }

  .nav-inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    font-family: 'DM Mono', 'Fira Mono', monospace;
    font-size: 0.85rem;
    font-weight: 500;
    color: #c8f5a0;
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: 'DM Mono', 'Fira Mono', monospace;
    font-size: 0.78rem;
    color: #888;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #e8e8e8;
  }

  .nav-link.active {
    color: #c8f5a0;
  }

  @media (max-width: 480px) {
    .site-nav {
      padding: 1.5rem 1rem 0;
    }
  }
</style>
